                    <h3 class="split__team"><span class="team-crest team-crest--xs crest-milan" aria-hidden="true">MIL</span>Milan<span class="split__count">2 kart</span></h3>
                    <ul class="item-list">
                      <li><span class="item-minute">67'</span><span class="item-main"><strong>Fikayo Tomori</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                      <li><span class="item-minute">83'</span><span class="item-main"><strong>Theo Hernández</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                    </ul>
                  </div>
                  <div class="split__col">
                    <h3 class="split__team"><span class="team-crest team-crest--xs crest-roma" aria-hidden="true">ROM</span>Roma<span class="split__count">4 kart</span></h3>
                    <ul class="item-list">
                      <li><span class="item-minute">27'</span><span class="item-main"><strong>Paulo Dybala</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                      <li><span class="item-minute">54'</span><span class="item-main"><strong>Bryan Cristante</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
                      <li><span class="item-minute">74'</span><span class="item-main"><strong>Gianluca Mancini</strong></span><span class="card-tag"><span class="i-card i-card--yellow"></span>Sarı</span></li>
