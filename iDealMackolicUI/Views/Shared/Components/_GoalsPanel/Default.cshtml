@{
	Layout = null;
}

<section class="panel" aria-labelledby="goals-title">
                <div class="panel__head"><h2 class="panel__title" id="goals-title">Goller</h2></div>
                <div class="split">
                  <div class="split__col">
                    <h3 class="split__team"><span class="team-crest team-crest--xs crest-milan" aria-hidden="true">MIL</span>Milan<span class="split__count">2 gol</span></h3>
                    <ul class="item-list goal-list">
                      <li><span class="item-minute">14'</span><span class="item-main"><strong>Rafael Leão</strong><small>Asist: Theo Hernández</small></span></li>
                      <li><span class="item-minute">41'</span><span class="item-main"><strong>Olivier Giroud</strong><small>Asist: Rafael Leão</small></span></li>
                    </ul>
                  </div>
                  <div class="split__col">
                    <h3 class="split__team"><span class="team-crest team-crest--xs crest-roma" aria-hidden="true">ROM</span>Roma<span class="split__count">1 gol</span></h3>
                    <ul class="item-list goal-list">
                      <li><span class="item-minute">72'</span><span class="item-main"><strong>Tammy Abraham</strong><small>Asist: Lorenzo Pellegrini</small></span></li>
                    </ul>
                  </div>
                </div>
              </section>
