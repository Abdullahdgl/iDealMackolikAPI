@{
	Layout = null;
}

<div class="period-cards">
            <article class="period-card">
              <p class="period-card__label">İlk yarı</p>
              <p class="period-card__score">2-0</p>
              <p class="period-card__note">Milan önde</p>
            </article>
            <article class="period-card">
              <p class="period-card__label">İkinci yarı</p>
              <p class="period-card__score">0-1</p>
              <p class="period-card__note">Roma önde</p>
            </article>
            <article class="period-card period-card--final">
              <p class="period-card__label">Sonuç</p>
              <p class="period-card__score">2-1</p>
              <p class="period-card__note">Milan kazandı</p>
            </article>
          </div>
