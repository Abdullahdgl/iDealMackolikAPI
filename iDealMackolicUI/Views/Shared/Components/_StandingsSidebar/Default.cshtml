@{
	Layout = null;
}

<aside class="col-xl-3" aria-label="Tablo açıklamaları">
          <div class="side-stack">
            <section class="side-card">
              <h2 class="side-card__title">Renklerin anlamı</h2>
              <ul class="legend-list">
                <li><span class="legend-swatch" style="--swatch:var(--blue)"></span><div><strong>Şampiyonlar Ligi</strong><span>1-4. sıra</span></div></li>
                <li><span class="legend-swatch" style="--swatch:var(--green)"></span><div><strong>Avrupa kupaları</strong><span>5-6. sıra</span></div></li>
                <li><span class="legend-swatch" style="--swatch:var(--red)"></span><div><strong>Düşme hattı</strong><span>18-20. sıra</span></div></li>
              </ul>
              <ul class="form-key" aria-label="Form rozetleri">
                <li><span class="form-badge form-badge--w">G</span>Galibiyet</li>
                <li><span class="form-badge form-badge--d">B</span>Beraberlik</li>
                <li><span class="form-badge form-badge--l">M</span>Mağlubiyet</li>
              </ul>
            </section>

            <section class="side-card">
              <h2 class="side-card__title">Formda olanlar</h2>
              <p>Son 5 maçta toplanan puan</p>
              <ol class="form-leaders">
              <li><span class="team-crest team-crest--sm" style="--crest-a:#0A4FA8;--crest-b:#101418;--crest-ink:#fff" aria-hidden="true">INT</span><span class="team-name">Inter</span><span class="form-leaders__pts">13 <small>/ 15</small></span><span class="form-meter" aria-hidden="true"><span style="--w:87%"></span></span></li>
              <li><span class="team-crest team-crest--sm" style="--crest-a:#1E6FB8;--crest-b:#111;--crest-ink:#fff" aria-hidden="true">ATA</span><span class="team-name">Atalanta</span><span class="form-leaders__pts">13 <small>/ 15</small></span><span class="form-meter" aria-hidden="true"><span style="--w:87%"></span></span></li>
              <li><span class="team-crest team-crest--sm" style="--crest-a:#1E9BD7;--crest-b:#0C3C78;--crest-ink:#fff" aria-hidden="true">NAP</span><span class="team-name">Napoli</span><span class="form-leaders__pts">10 <small>/ 15</small></span><span class="form-meter" aria-hidden="true"><span style="--w:67%"></span></span></li>
              </ol>
            </section>

            <section class="side-card note-card">
              <h2 class="side-card__title">Sıralama notu</h2>
              <p>Puan eşitliğinde averaj dikkate alınır. Averaj da eşitse atılan gol sayısına bakılır.</p>
              <p>Son 5 maçta en sağdaki rozet en son oynanan maçtır.</p>
            </section>
          </div>
        </aside>
